<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Reference copy. scripts/install.sh generates and installs this file
     to /Library/LaunchDaemons/local.golinks.plist. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.golinks</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/golinks</string>
		<string>-config</string>
		<string>/usr/local/etc/golinks/config.json</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/usr/local/var/golinks</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/usr/local/var/golinks/golinks.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/golinks/golinks.err.log</string>
</dict>
</plist>
